{% macro icon(nome, classe = '') %}<svg class="g-icon {{ classe }}" aria-hidden="true" viewBox="0 0 24 24"><use href="#g-{{ nome }}"/></svg>{% endmacro %}
{% macro status(valor) %}{% set nomes = {'disponivel':'Em estoque', 'baixo':'Estoque baixo', 'esgotado':'Sem estoque', 'arquivado':'Arquivado', 'ativo':'Ativo', 'vencido':'Vencido', 'inativo':'Desativado', 'ABERTO':'Aberto', 'PAGO':'Pago', 'ENVIADO':'Enviado', 'ENTREGUE':'Entregue', 'CANCELADO':'Cancelado'} %}<span class="status status-{{ valor|lower }}"><span aria-hidden="true"></span>{{ nomes[valor] ?? valor }}</span>{% endmacro %}
{% macro foto(produto) %}<span class="admin-photo {% if produto.imagem == '/assets/images/catalogo.webp' %}atlas atlas-{{ produto.imagem_posicao }}{% endif %}" {% if produto.imagem %}style="background-image:url('{{ produto.imagem|e }}')"{% endif %} aria-hidden="true">{% if not produto.imagem %}{{ _self.icon('box') }}{% endif %}</span>{% endmacro %}
