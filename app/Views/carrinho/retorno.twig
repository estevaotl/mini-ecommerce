{% extends 'loja/base.twig' %}{% import 'loja/macros.twig' as ui %}
{% block title %}{{ resumo ? 'Pedido registrado' : 'Seu pedido' }}{% endblock %}
{% block content %}<main id="conteudo" class="wrap confirmation-page">{% if resumo %}<div class="confirmation-check">{{ ui.icon('check') }}</div>
<p class="product-category">Pedido #{{ resumo.idPedido }}</p>
<h1>Suas ideias estão<br>de malas prontas.</h1>
<p>Seu pedido foi registrado, {{ resumo.nome }}.</p>
<p class="checkout-disclaimer">{% if resumo.demo %}Este é um pedido de demonstração. Nenhuma cobrança ou entrega será realizada.{% else %}Pedido aberto. Nenhum pagamento foi cobrado.{% endif %}</p>
<div class="confirmation-summary">
<h2>Resumo do pedido</h2>{% for item in resumo.itens %}<div>
<span>{{ item.nome }}<small>{{ item.cor }} / {{ item.tamanho }} / {{ item.quantidade }} un.</small>
</span>
<strong>R$ {{ item.total|number_format(2, ',', '.') }}</strong>
</div>{% endfor %}<div>
<span>Frete</span>
<strong>R$ {{ resumo.frete|number_format(2, ',', '.') }}</strong>
</div>{% if resumo.desconto %}<div>
<span>Desconto</span>
<strong>− R$ {{ resumo.desconto|number_format(2, ',', '.') }}</strong>
</div>{% endif %}<div class="summary-total">
<span>Total</span>
<strong>R$ {{ resumo.total|number_format(2, ',', '.') }}</strong>
</div>
<p>{{ resumo.enderecoFormatado }}</p>
</div>{% else %}<h1>Uma nova ideia<br>começa por aqui.</h1>
<p>Você ainda não registrou um pedido nesta sessão.</p>{% endif %}<a class="button button-blue" href="/colecao">Voltar para a coleção {{ ui.icon('arrow') }}</a>
</main>{% endblock %}
