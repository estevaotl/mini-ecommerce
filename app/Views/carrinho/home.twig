{% extends 'loja/base.twig' %}
{% import 'loja/macros.twig' as ui %}
{% block title %}Sua sacola{% endblock %}
{% block content %}
<main id="conteudo" class="wrap checkout-page">
    <a class="back-link" href="/colecao">{{ ui.icon('arrow') }} Continuar escolhendo</a>
    <div class="section-heading"><div><h1>Quase suas.</h1><p>Suas peças, seu endereço e uma última conferida.</p></div></div>
    <nav class="checkout-progress" aria-label="Etapas do pedido">
        <ol>
            <li><a href="#checkout-itens" data-checkout-step="1" aria-current="step"><span>1</span> Suas peças</a></li>
            <li><a href="#checkout-entrega" data-checkout-step="2"><span>2</span> Entrega</a></li>
            <li><a href="#checkout-revisao" data-checkout-step="3"><span>3</span> Revisão</a></li>
        </ol>
    </nav>
    <div class="checkout-grid">
        <div class="checkout-main">
            <section class="checkout-section" id="checkout-itens" aria-labelledby="cart-items-title">
                <div class="checkout-section-title"><span class="step-number" aria-hidden="true">1</span><div><h2 id="cart-items-title">Suas peças</h2><p>Confira as versões e as quantidades.</p></div></div>
                <div class="checkout-items" data-checkout-items></div>
            </section>
            <form id="checkout-form" class="checkout-form checkout-section" data-checkout-form aria-labelledby="delivery-title">
                <div id="checkout-entrega" class="checkout-section-title"><span class="step-number" aria-hidden="true">2</span><div><h2 id="delivery-title">Dados de entrega</h2><p>Para quem e para onde vão suas próximas favoritas?</p></div></div>
                <div class="validation-summary" data-validation-summary role="alert" tabindex="-1" aria-labelledby="validation-title" hidden><h3 id="validation-title">Falta conferir alguns dados</h3><p>Corrija os campos indicados para continuar.</p><ul data-validation-links></ul></div>
                <fieldset class="checkout-fieldset"><legend>Quem vai receber?</legend><div class="form-grid">
                    <div class="form-field"><label for="delivery-nome">Nome completo</label><input id="delivery-nome" name="nome" autocomplete="name" required maxlength="200" aria-describedby="error-nome"><p id="error-nome" class="field-error" data-field-error="nome" hidden></p></div>
                    <div class="form-field"><label for="delivery-email">E-mail</label><input id="delivery-email" type="email" name="email" autocomplete="email" placeholder="voce@exemplo.com" required maxlength="254" aria-describedby="hint-email error-email"><p id="hint-email" class="field-hint">Use um endereço de e-mail válido para identificar seu pedido.</p><p id="error-email" class="field-error" data-field-error="email" hidden></p></div>
                </div></fieldset>
                <fieldset class="checkout-fieldset"><legend>Seu endereço</legend><div class="form-grid">
                    <div class="form-field"><label for="delivery-cep">CEP</label><input id="delivery-cep" name="cep" autocomplete="postal-code" inputmode="numeric" placeholder="00000-000" maxlength="9" pattern="[0-9]{5}-?[0-9]{3}" required aria-describedby="error-cep cep-feedback"><p id="error-cep" class="field-error" data-field-error="cep" hidden></p></div>
                    <div class="cep-action"><button class="button button-outline" type="button" data-lookup-cep>Consultar CEP</button></div>
                    <p id="cep-feedback" class="form-feedback full" data-cep-feedback role="status"></p>
                    <p class="field-hint full">Você também pode preencher o endereço manualmente.</p>
                    <div class="form-field full"><label for="delivery-endereco">Endereço</label><input id="delivery-endereco" name="endereco" autocomplete="address-line1" required maxlength="300" aria-describedby="error-endereco"><p id="error-endereco" class="field-error" data-field-error="endereco" hidden></p></div>
                    <div class="form-field"><label for="delivery-numero">Número</label><input id="delivery-numero" name="numero" autocomplete="off" placeholder="123 ou s/n" required maxlength="20" aria-describedby="error-numero"><p id="error-numero" class="field-error" data-field-error="numero" hidden></p></div>
                    <div class="form-field"><label for="delivery-complemento">Complemento (opcional)</label><input id="delivery-complemento" name="complemento" autocomplete="address-line2" maxlength="100"></div>
                    <div class="form-field"><label for="delivery-cidade">Cidade</label><input id="delivery-cidade" name="cidade" autocomplete="address-level2" required maxlength="150" aria-describedby="error-cidade"><p id="error-cidade" class="field-error" data-field-error="cidade" hidden></p></div>
                    <div class="form-field"><label for="delivery-uf">Estado</label><input id="delivery-uf" name="uf" autocomplete="address-level1" placeholder="SP" minlength="2" maxlength="2" pattern="[A-Za-z]{2}" required aria-describedby="hint-uf error-uf"><p id="hint-uf" class="field-hint">Sigla com duas letras, como SP.</p><p id="error-uf" class="field-error" data-field-error="uf" hidden></p></div>
                </div></fieldset>
                <p class="form-feedback" role="alert" tabindex="-1" data-checkout-feedback></p>
            </form>
        </div>
        <aside class="order-summary" id="checkout-revisao" aria-labelledby="review-title">
            <div class="checkout-section-title"><span class="step-number" aria-hidden="true">3</span><div><h2 id="review-title">Última conferida</h2><p>Tudo pronto para ser seu?</p></div></div>
            <div data-checkout-summary></div>
            <form class="coupon-form" data-coupon-form><label for="coupon-code">Tem um cupom?</label><div class="coupon-input"><input id="coupon-code" name="codigo" placeholder="Digite seu código" maxlength="100" aria-describedby="coupon-feedback"><button class="button button-outline" type="submit">Aplicar</button></div><p id="coupon-feedback" class="form-feedback" data-coupon-feedback role="status"></p></form>
            <div class="shipping-note">{{ ui.icon('truck') }}<p>Frete grátis em compras acima de R$ 200. O desconto do cupom aparece no total.</p></div>
            <button type="submit" form="checkout-form" class="button button-blue confirm-order" data-confirm-order>Confirmar pedido {{ ui.icon('arrow') }}</button>
            <p class="checkout-disclaimer">{% if demo %}Ambiente de demonstração. Nenhum pagamento será cobrado.{% else %}O pedido será registrado. O pagamento ainda não está disponível nesta loja.{% endif %}</p>
        </aside>
    </div>
</main>
<div class="checkout-mobile-bar" data-checkout-mobile-bar hidden><div><span>Total da sacola</span><strong data-checkout-total></strong></div><a class="button button-blue" href="#checkout-revisao" data-review-order>Revisar pedido {{ ui.icon('arrow') }}</a></div>
{% endblock %}
{% block data %}<script type="application/json" id="initial-cart">{{ sacola|json_encode(15)|raw }}</script>{% endblock %}
